# Public site configuration
NEXT_PUBLIC_SITE_URL=https://piercebusinessintegrations.com
# Set only after confirming this @pbintegrations.com mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only contact delivery configuration
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_EMAIL=

# Server-only invitation secret for the unlisted project-intake link.
# Generate at least 32 random bytes, encode as base64url or hex, and keep it private.
PROJECT_INTAKE_ACCESS_TOKEN=

# PBI client portal: local dev uses an ignored .data/portal.sqlite file when URL is blank.
# Beta deployments require a remote libSQL URL and token.
PORTAL_DATABASE_URL=
PORTAL_DATABASE_AUTH_TOKEN=

# Clerk hosted client sign-in; both keys are required on beta.
# Set Clerk Access mode to Invite-only in its dashboard before enabling these keys.
# /sign-up is for invitation tickets only; public navigation points to /clients.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
# Comma-separated origins allowed to authorize Clerk requests for this deployment.
# Production default is https://client.piercebusinessintegrations.com;
# preview default is https://beta.piercebusinessintegrations.com.
PORTAL_AUTHORIZED_ORIGINS=
# Used only by the one-time owner bootstrap command, never by the website runtime.
PORTAL_ADMIN_USER_ID=
# Optional local-only simulation cookie secret.
PORTAL_DEV_SECRET=

# Dropbox Sign API app test mode. The code always sends test_mode=1.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
PBI_SIGNER_EMAIL=
PBI_SIGNER_NAME=

# Stripe test credentials only; live secret keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after ACH is enabled in the Stripe test account.
STRIPE_ENABLE_ACH=false
