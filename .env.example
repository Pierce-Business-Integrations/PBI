# Public site configuration
NEXT_PUBLIC_SITE_URL=https://piercebusinessintegrations.com
# Set only after confirming this @pbintegrations.com mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional ownership verification values, not full HTML tags.
# Google Domain properties use DNS instead; these support URL-prefix/HTML verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only contact delivery configuration
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_EMAIL=

# Server-only invitation secret for the unlisted project-intake link.
# Generate at least 32 random bytes, encode as base64url or hex, and keep it private.
PROJECT_INTAKE_ACCESS_TOKEN=

# Local preview only: blank uses ignored .data/portal.sqlite. Never a hosted database.
PORTAL_DATABASE_URL=
# One hosted Supabase project: Auth + PostgreSQL + private Storage.
# Disable public signups/anonymous access in Supabase; see docs/client-portal/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret/service-role key. Never expose this in NEXT_PUBLIC variables.
SUPABASE_SECRET_KEY=
# Copy Supabase Connect -> Transaction pooler URL; include sslmode=verify-full.
# Apply supabase/migrations/202610020001_portal.sql first. No runtime hosted DDL.
SUPABASE_DB_URL=
# Optional PEM certificate from Supabase's SSL settings if the connection requires its CA.
SUPABASE_DB_CA_CERT=
# One-time bootstrap: existing verified Supabase Auth user UUID, never an email or public metadata role.
PORTAL_ADMIN_USER_ID=
# Optional local-only simulation cookie secret.
PORTAL_DEV_SECRET=

# SignWell embedded API. Code forces test_mode=true and suppresses recipient notifications.
SIGNWELL_API_KEY=
# ID returned when registering this deployment's webhook; used as its HMAC key.
SIGNWELL_WEBHOOK_ID=
PBI_SIGNER_EMAIL=
PBI_SIGNER_NAME=

# Stripe test credentials only; live secret keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after ACH is enabled in the Stripe test account.
STRIPE_ENABLE_ACH=false
